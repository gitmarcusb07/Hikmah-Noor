---
/* Islamic Calendar hub (locales) — mirrors EN with localized links. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import IslamicCalendar from '../../components/IslamicCalendar.astro';
import MonthGrid from '../../components/MonthGrid.astro';
import { CAL_META, calMetaFor } from '../../lib/calendar-meta';
import { nonDefaultLocales } from '../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
---
<BaseLayout title={calMetaFor(locale).title} description={calMetaFor(locale).description} keywords={calMetaFor(locale).keywords} locale={locale} type="collection" faq={CAL_META.faq} crumbs={[{ name: 'Home', path: '/' }, { name: 'Islamic Calendar', path: '/calendar/' }]} canonicalPath="/calendar/">
  <IslamicCalendar locale={locale} />
  <div class="max-w-7xl mx-auto px-4 pb-6 md:pb-8">
    <MonthGrid locale={locale} />
  </div>
</BaseLayout>
