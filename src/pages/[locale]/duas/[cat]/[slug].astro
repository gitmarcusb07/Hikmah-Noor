---
/* Locale dua detail — mirrors the English route at src/pages/duas/[slug]/[dua].astro.
 * English detail URLs already existed; only the hi/ur/ar detail URLs were missing
 * (they had no 3-segment route, so /hi/duas/<cat>/<slug>/ 404'd). Unknown
 * cat/slug pairs are never generated by getStaticPaths, so they 404. */
import DuaDetail from '../../../../components/DuaDetail.astro';
import { DUA_CATS, DUAS } from '../../../../data/duas';
import { nonDefaultLocales } from '../../../../i18n/utils';

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const locale of nonDefaultLocales) {
    for (const c of DUA_CATS) {
      for (const d of DUAS.filter((x) => x.cat === c.slug)) {
        paths.push({ params: { locale, cat: c.slug, slug: d.slug }, props: { dua: d, cat: c } });
      }
    }
  }
  return paths;
}

const { dua, cat } = Astro.props;
const { locale } = Astro.params;
---
<DuaDetail dua={dua} cat={cat} locale={locale} />
